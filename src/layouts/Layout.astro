---
import '../styles/global.css';

interface Props {
  title?: string;
}

const { title = 'Toch Sothak — Backend & Mobile Developer' } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta
      name="description"
      content="Toch Sothak — Backend & Mobile Developer in Phnom Penh, Cambodia. PHP backend APIs and Flutter mobile apps."
    />
    <link rel="icon" type="image/svg+xml" href={import.meta.env.BASE_URL + 'favicon.svg'} />
    <meta property="og:title" content="Toch Sothak — Backend & Mobile Developer" />
    <meta
      property="og:description"
      content="Toch Sothak — Backend & Mobile Developer in Phnom Penh, Cambodia. PHP backend APIs and Flutter mobile apps."
    />
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://tochsothak.github.io/" />
    <meta property="og:image" content="https://tochsothak.github.io/photo.jpg" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="Toch Sothak — Backend & Mobile Developer" />
    <meta
      name="twitter:description"
      content="Toch Sothak — Backend & Mobile Developer in Phnom Penh, Cambodia. PHP backend APIs and Flutter mobile apps."
    />
    <title>{title}</title>
  </head>
  <body class="bg-slate-50 text-slate-800 antialiased">
    <slot />
  </body>
</html>
